VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# OSM vector street style. Buyers only see a street map, never satellite imagery.
# Leave blank to use OpenFreeMap Bright. Swap for another street style later.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# Admin locating map only. Buyers never load this. Leave blank for Esri World Imagery.
# Production use needs an ArcGIS Location Platform account: see the README.
VITE_ADMIN_IMAGERY_URL=
VITE_ADMIN_IMAGERY_ATTRIBUTION=
